<view class="container">
  <view class="header">
    <view class="icon-placeholder">📏</view>
    <text class="title">皮肤面积测量</text>
    <text class="subtitle">简单 · 规范 · 可复现</text>
  </view>

  <view class="guide">
    <text class="guide-title">测量步骤</text>
    <view class="guide-step">
      <text class="step-num">1</text>
      <text class="step-text">拍照（包含比例尺）</text>
    </view>
    <view class="guide-step">
      <text class="step-num">2</text>
      <text class="step-text">标定比例尺（0mm → 10mm）</text>
    </view>
    <view class="guide-step">
      <text class="step-num">3</text>
      <text class="step-text">描画病变区域轮廓</text>
    </view>
    <view class="guide-step">
      <text class="step-num">4</text>
      <text class="step-text">自动计算面积</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="goMeasure">立即测量</button>
    <button class="btn-secondary" bindtap="goHistory">历史记录</button>
  </view>

  <view class="privacy-note">
    <text>所有数据仅保存在本地设备，不上传至任何服务器</text>
  </view>
</view>